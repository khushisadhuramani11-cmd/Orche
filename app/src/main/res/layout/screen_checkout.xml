<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/orche_ivory">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/checkoutBottomStickyBar"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- Header matching Figma Screen 04 -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="44dp">

                <ImageView
                    android:id="@+id/backButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:padding="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/ic_back"
                    app:tint="@color/orche_plum" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:fontFamily="@font/font_cormorant"
                    android:text="Checkout"
                    android:textColor="@color/orche_plum"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- Stepper matching Figma (1 ADDRESS ───── 2 PAYMENT) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="1  ADDRESS     ─────     2  PAYMENT"
                android:textColor="@color/orche_plum"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Fulfillment Destination Header -->
            <TextView
                android:id="@+id/txtDestinationHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="@font/font_cormorant"
                android:text="Delivery address"
                android:textColor="@color/orche_plum"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Destination Address Card matching Figma -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/orche_border"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/orche_white">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/txtCustomerName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Customer name"
                        android:textColor="@color/orche_charcoal"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnChangeAddress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="CHANGE"
                        android:textColor="@color/orche_plum"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/txtAddressBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/txtCustomerName"
                        android:layout_marginTop="6dp"
                        android:text="Home · Linking Road, Bandra West\nMumbai, Maharashtra 400050"
                        android:textColor="@color/orche_muted"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp" />
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Delivery / Fulfillment Method Section matching Figma -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/font_cormorant"
                android:text="Delivery method"
                android:textColor="@color/orche_plum"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Method 1: Standard Delivery matching Figma -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMethodStandard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/orche_plum"
                app:strokeWidth="1.5dp"
                app:cardBackgroundColor="@color/orche_white">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp">

                    <RadioButton
                        android:id="@+id/radioStandardDelivery"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:checked="true"
                        android:clickable="false" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@+id/radioStandardDelivery"
                        android:layout_marginStart="8dp"
                        android:layout_centerVertical="true"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Standard delivery"
                            android:textColor="@color/orche_charcoal"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2–5 business days · 100% Discreet"
                            android:textColor="@color/orche_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtDeliveryFeeLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="₹60"
                        android:textColor="@color/orche_charcoal"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Method 2: In-Store Pickup Option (McDonald's Omnichannel) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMethodPickup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/orche_border"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/orche_white">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp">

                    <RadioButton
                        android:id="@+id/radioStorePickup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:checked="false"
                        android:clickable="false" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@+id/radioStorePickup"
                        android:layout_marginStart="8dp"
                        android:layout_centerVertical="true"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bandra Boutique Pickup"
                            android:textColor="@color/orche_charcoal"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ready in 1 hour · Free fitting assistance"
                            android:textColor="@color/orche_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="FREE"
                        android:textColor="@color/orche_success"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Payment Method Section matching Figma Screen 04 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/font_cormorant"
                android:text="Payment method"
                android:textColor="@color/orche_plum"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Payment Radio Cards matching Figma -->
            <RadioGroup
                android:id="@+id/radioGroupPayment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <RadioButton
                    android:id="@+id/payUPI"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/card_background"
                    android:checked="true"
                    android:paddingStart="10dp"
                    android:text="UPI / QR (Google Pay, PhonePe, Paytm)"
                    android:textColor="@color/orche_charcoal"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/payCard"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/card_background"
                    android:paddingStart="10dp"
                    android:text="Credit or debit card"
                    android:textColor="@color/orche_charcoal"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/payNetBanking"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/card_background"
                    android:paddingStart="10dp"
                    android:text="Net banking"
                    android:textColor="@color/orche_charcoal"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/payCounter"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/card_background"
                    android:paddingStart="10dp"
                    android:text="Pay at Boutique Counter / COD"
                    android:textColor="@color/orche_charcoal"
                    android:textSize="13sp" />
            </RadioGroup>

            <!-- Total Payable Summary Row matching Figma -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total payable"
                    android:textColor="@color/orche_plum"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtCheckoutTotalPayable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="₹1,758"
                    android:textColor="@color/orche_plum"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </RelativeLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Sticky Bottom Bar matching Figma Screen 04 -->
    <LinearLayout
        android:id="@+id/checkoutBottomStickyBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/orche_ivory"
        android:elevation="6dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="14dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/placeOrderButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:fontFamily="@font/font_cormorant"
            android:text="Place order · ₹1,758"
            android:textAllCaps="false"
            android:textColor="@color/orche_white"
            android:textSize="17sp"
            android:textStyle="bold"
            app:backgroundTint="@color/orche_plum"
            app:cornerRadius="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:text="Payments processed securely · 100% Discreet"
            android:textColor="@color/orche_muted"
            android:textSize="11sp" />
    </LinearLayout>

</RelativeLayout>
