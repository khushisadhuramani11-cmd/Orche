<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/card_background"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Item Image Card matching Figma -->
    <FrameLayout
        android:layout_width="80dp"
        android:layout_height="84dp"
        android:background="@drawable/product_placeholder">

        <ImageView
            android:id="@+id/cartItemImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerInside"
            android:src="@drawable/ic_bra_illustration" />
    </FrameLayout>

    <!-- Item Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/cartItemTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/font_product_name"
            android:text="Soft Form Bra"
            android:textColor="@color/orche_charcoal"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cartItemVariant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Rose Nude · 34B"
            android:textColor="@color/orche_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/cartItemPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/font_cormorant"
            android:text="₹1,199"
            android:textColor="@color/orche_plum"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Stepper matching Figma (- 1 +) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_chip_unselected"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/btnMinus"
                android:layout_width="28dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="-"
                android:textColor="@color/orche_charcoal"
                android:textSize="16sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/txtQuantity"
                android:layout_width="28dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/orche_charcoal"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnPlus"
                android:layout_width="28dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="+"
                android:textColor="@color/orche_charcoal"
                android:textSize="16sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- Remove Button -->
    <TextView
        android:id="@+id/btnRemoveItem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="6dp"
        android:text="✕"
        android:textColor="@color/orche_muted"
        android:textSize="14sp"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
