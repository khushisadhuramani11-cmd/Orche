<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/orche_ivory">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/cartBottomStickyBar"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- Top Header matching Figma Screen 03 -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="44dp">

                <ImageView
                    android:id="@+id/backButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:padding="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/ic_back"
                    app:tint="@color/orche_plum" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:fontFamily="@font/font_cormorant"
                    android:text="Your bag"
                    android:textColor="@color/orche_plum"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- Item Count Header matching Figma -->
            <TextView
                android:id="@+id/txtCartItemCountHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="2 ITEMS"
                android:textColor="@color/orche_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Dynamic Cart Items Container -->
            <LinearLayout
                android:id="@+id/cartItemsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Empty Cart State -->
            <TextView
                android:id="@+id/txtEmptyCart"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:gravity="center"
                android:text="Your bag is empty.\nExplore the collection to add intimates."
                android:textColor="@color/orche_muted"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- Fulfillment Toggle: Delivery vs In-Store Pickup -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/card_background"
                android:orientation="horizontal"
                android:padding="3dp">

                <TextView
                    android:id="@+id/cartModeDelivery"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_selected"
                    android:gravity="center"
                    android:text="🛵 Door Delivery"
                    android:textColor="@color/orche_white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/cartModeInStore"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="🏬 Free Store Pickup"
                    android:textColor="@color/orche_plum"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Promo Code Section matching Figma Screen 03 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="PROMO CODE"
                android:textColor="@color/orche_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/editPromoCode"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/card_background"
                    android:hint="Enter code (e.g. ORCHE10)"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/orche_charcoal"
                    android:textColorHint="@color/orche_muted"
                    android:textSize="13sp"
                    android:inputType="textCapCharacters" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnApplyPromo"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:text="Apply"
                    android:textAllCaps="false"
                    android:textColor="@color/orche_plum"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/orche_rose_card"
                    app:cornerRadius="12dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />
            </LinearLayout>

            <!-- Promo applied success/error banner -->
            <TextView
                android:id="@+id/txtPromoStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Code ORCHE10 applied! 10% discount"
                android:textColor="@color/orche_success"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Order Summary Section matching Figma Screen 03 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:fontFamily="@font/font_cormorant"
                android:text="Order summary"
                android:textColor="@color/orche_plum"
                android:textSize="24sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical">

                <!-- Subtotal Row -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Subtotal"
                        android:textColor="@color/orche_charcoal"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/txtCartSubtotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="₹1,698"
                        android:textColor="@color/orche_charcoal"
                        android:textSize="14sp" />
                </RelativeLayout>

                <!-- Discount Row -->
                <RelativeLayout
                    android:id="@+id/rowDiscount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Discount (Promo)"
                        android:textColor="@color/orche_success"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/txtCartDiscount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="-₹170"
                        android:textColor="@color/orche_success"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <!-- Shipping Row -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Shipping"
                        android:textColor="@color/orche_charcoal"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/txtCartShipping"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="Calculated next"
                        android:textColor="@color/orche_muted"
                        android:textSize="14sp" />
                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="@color/orche_border" />

                <!-- Total Row -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total"
                        android:textColor="@color/orche_plum"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/txtCartTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="₹1,698"
                        android:textColor="@color/orche_plum"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </RelativeLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Sticky Bottom Bar matching Figma Screen 03 -->
    <LinearLayout
        android:id="@+id/cartBottomStickyBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/orche_ivory"
        android:elevation="6dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="14dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/checkoutButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:fontFamily="@font/font_cormorant"
            android:text="Proceed to checkout"
            android:textAllCaps="false"
            android:textColor="@color/orche_white"
            android:textSize="17sp"
            android:textStyle="bold"
            app:backgroundTint="@color/orche_plum"
            app:cornerRadius="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:text="Secure checkout · Discreet delivery"
            android:textColor="@color/orche_muted"
            android:textSize="11sp" />
    </LinearLayout>

</RelativeLayout>
