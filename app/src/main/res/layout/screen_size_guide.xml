<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/orche_ivory"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="28dp">

        <!-- Top Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="44dp">

            <ImageView
                android:id="@+id/backButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:padding="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/ic_back"
                app:tint="@color/orche_plum" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="@font/font_cormorant"
                android:text="Size Guide &amp; Fit"
                android:textColor="@color/orche_plum"
                android:textSize="24sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Measurement Guide Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/orche_rose_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HOW TO MEASURE AT HOME"
                    android:textColor="@color/orche_plum_light"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="1. Band: Measure snug directly under your bust ribcage."
                    android:textColor="@color/orche_charcoal"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="2. Bust: Measure gently around the fullest part of your chest."
                    android:textColor="@color/orche_charcoal"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLaunchCalculatorFromGuide"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/font_cormorant"
                    android:text="Open Interactive Fit Calculator"
                    android:textAllCaps="false"
                    android:textColor="@color/orche_white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/orche_plum"
                    app:cornerRadius="10dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- International Size Conversion Table -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/font_cormorant"
            android:text="International Size Conversion"
            android:textColor="@color/orche_plum"
            android:textSize="22sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/orche_border"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/orche_white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- Header Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="India / UK" android:textStyle="bold" android:textColor="@color/orche_plum" android:textSize="12sp"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="US" android:textStyle="bold" android:textColor="@color/orche_plum" android:textSize="12sp"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="EU" android:textStyle="bold" android:textColor="@color/orche_plum" android:textSize="12sp"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="France" android:textStyle="bold" android:textColor="@color/orche_plum" android:textSize="12sp"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" android:background="@color/orche_border" />

                <!-- Row 1 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="30B" android:textColor="@color/orche_charcoal" android:textSize="12sp"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="30B" android:textColor="@color/orche_charcoal" android:textSize="12sp"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="65B" android:textColor="@color/orche_charcoal" android:textSize="12sp"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="80B" android:textColor="@color/orche_charcoal" android:textSize="12sp"/>
                </LinearLayout>

                <!-- Row 2 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="32B" android:textColor="@color/orche_charcoal" android:textSize="12sp"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="32B" android:textColor="@color/orche_charcoal" android:textSize="12sp"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="70B" android:textColor="@color/orche_charcoal" android:textSize="12sp"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="85B" android:textColor="@color/orche_charcoal" android:textSize="12sp"/>
                </LinearLayout>

                <!-- Row 3 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="34B" android:textStyle="bold" android:textColor="@color/orche_plum" android:textSize="12sp"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="34B" android:textStyle="bold" android:textColor="@color/orche_plum" android:textSize="12sp"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="75B" android:textStyle="bold" android:textColor="@color/orche_plum" android:textSize="12sp"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="90B" android:textStyle="bold" android:textColor="@color/orche_plum" android:textSize="12sp"/>
                </LinearLayout>

                <!-- Row 4 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="36B" android:textColor="@color/orche_charcoal" android:textSize="12sp"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="36B" android:textColor="@color/orche_charcoal" android:textSize="12sp"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="80B" android:textColor="@color/orche_charcoal" android:textSize="12sp"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="95B" android:textColor="@color/orche_charcoal" android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Fit Troubleshooting & FAQs -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/font_cormorant"
            android:text="Fit Troubleshooting &amp; FAQs"
            android:textColor="@color/orche_plum"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- FAQ 1 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/orche_border"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/orche_white">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Q: Band riding up your back?" android:textColor="@color/orche_plum" android:textStyle="bold" android:textSize="13sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Your band is likely too loose. 80% of support comes from the band. Try going down one band size and up one cup size (e.g. 36A -> 34B)." android:textColor="@color/orche_muted" android:textSize="12sp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- FAQ 2 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/orche_border"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/orche_white">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Q: Straps digging into shoulders?" android:textColor="@color/orche_plum" android:textStyle="bold" android:textSize="13sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Straps shouldn't carry weight. If they dig, tighten the back band hooks or step down a band size so the foundation carries the weight." android:textColor="@color/orche_muted" android:textSize="12sp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- FAQ 3 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/orche_border"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/orche_white">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Q: Cup spillage or gaping?" android:textColor="@color/orche_plum" android:textStyle="bold" android:textSize="13sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Overflow means you need a larger cup size. Gaping means the cup is too large or the wire shape doesn't match your root." android:textColor="@color/orche_muted" android:textSize="12sp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
